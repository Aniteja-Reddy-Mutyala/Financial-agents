# Copy this file to .env and fill in real values — .env is gitignored,
# this template is not. Nothing in this project auto-loads .env (no
# python-dotenv dependency); source it explicitly before a command that
# needs one of these, e.g.:
#   set -a && source .env && set +a && python3 eval/run_judge.py

# Hugging Face API token (eval/llm_judge.py's original HF-based judge
# attempt — currently unused; kept as reference). huggingface.co/settings/tokens
HF_TOKEN=

# Groq API token — powers eval/llm_judge.py's semantic LLM-judge pass
# (open-weight model, no Bedrock cost). console.groq.com
GROQ_API_KEY=

# GitHub personal access token — used for one-off repo automation (e.g.
# creating issues via the API) run from this project. Scope it to just
# this repo with "Issues: Read and write" if using a fine-grained token.
# github.com/settings/tokens
GITHUB_TOKEN=
